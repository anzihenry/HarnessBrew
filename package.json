{
  "name": "harnessbrew",
  "version": "0.4.0",
  "description": "A Git-native package manager for AI Agent assets.",
  "type": "module",
  "bin": {
    "harnessbrew": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "start": "node ./dist/cli.js",
    "test": "npm run build:test && node --test .test-dist/tests/*.test.js",
    "test:package": "npm run build && node ./scripts/package-smoke.mjs",
    "check": "npm run build && npm test && npm run test:package && npm pack --dry-run --cache .npm-cache",
    "prepack": "npm run build"
  },
  "keywords": [
    "agent",
    "assets",
    "skills",
    "instructions",
    "git",
    "package-manager"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anzihenry/HarnessBrew.git"
  },
  "homepage": "https://github.com/anzihenry/HarnessBrew#readme",
  "bugs": {
    "url": "https://github.com/anzihenry/HarnessBrew/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
