{
  "name": "harnessbrew",
  "version": "0.8.0",
  "description": "A Git-native package manager for AI Agent assets.",
  "type": "module",
  "bin": {
    "harnessbrew": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ./scripts/clean-build.mjs dist && tsc -p tsconfig.json",
    "build:test": "node ./scripts/clean-build.mjs .test-dist && tsc -p tsconfig.test.json",
    "start": "node ./dist/bin.js",
    "test": "npm run test:fast",
    "artifact:build": "node ./scripts/artifact/build.mjs --output ./release-artifacts",
    "artifact:verify": "node ./scripts/artifact/verify.mjs",
    "test:package": "node ./scripts/package-smoke.mjs",
    "test:e2e": "node ./scripts/e2e/run.mjs",
    "release:gate": "node ./scripts/release-gate.mjs",
    "release:preflight": "node ./scripts/runtime/preflight.mjs",
    "check": "npm run build && npm test && npm run release:verify",
    "release:verify": "node ./scripts/release-check.mjs",
    "prepack": "npm run build",
    "test:fast": "npm run build:test && node scripts/test/run.mjs fast",
    "test:packaged": "npm run build:test && node scripts/test/run.mjs packaged",
    "test:regressions": "npm run build:test && node scripts/test/run.mjs regressions",
    "check:all": "npm run check && npm run test:packaged && npm run test:regressions"
  },
  "keywords": [
    "agent",
    "assets",
    "skills",
    "instructions",
    "git",
    "package-manager"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anzihenry/HarnessBrew.git"
  },
  "homepage": "https://github.com/anzihenry/HarnessBrew#readme",
  "bugs": {
    "url": "https://github.com/anzihenry/HarnessBrew/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "toml-eslint-parser": "0.10.0",
    "yaml": "^2.9.0"
  }
}
